# ReVeil Discord bot
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id

# Optional: register commands in one server instead of globally (instant rollout)
# DISCORD_GUILD_ID=123456789012345678

# Optional: override the attachment ceiling (default 8 MiB - 8 KiB)
# DISCORD_MAX_OUTPUT_BYTES=8380416

# Access control. The bot is private: only the owner may use it until they run
# /give-access or /access-channel. REVEIL_OWNER_ID overrides the stored owner.
# REVEIL_OWNER_ID=1380042914922758224
# REVEIL_ACCESS_FILE=./data/access.json
